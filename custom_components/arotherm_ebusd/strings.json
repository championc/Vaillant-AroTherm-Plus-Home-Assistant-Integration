{
  "_version": "0.3.0",
  "config": {
    "step": {
      "user": {
        "title": "Connect to ebusd",
        "description": "Enter the address of the machine running ebusd (not the eBUS adapter). Only read commands are sent while setting up.",
        "data": {
          "host": "Host",
          "tcp_port": "TCP command port",
          "http_port": "HTTP/JSON port (0 = don't use)"
        },
        "data_description": {
          "host": "e.g. 192.168.1.22",
          "tcp_port": "ebusd --port (default 8888)",
          "http_port": "ebusd --httpport (default 8889)"
        }
      },
      "reconfigure": {
        "title": "Change ebusd connection",
        "data": {
          "host": "Host",
          "tcp_port": "TCP command port",
          "http_port": "HTTP/JSON port (0 = don't use)"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to ebusd on the TCP port.",
      "not_ebusd": "Something answered, but it is not ebusd.",
      "no_heatpump": "ebusd is running but no heat pump (HMU) was found on the bus.",
      "http_failed": "The HTTP/JSON port did not answer. Fix it or set it to 0."
    },
    "abort": {
      "already_configured": "This ebusd is already configured.",
      "reconfigure_successful": "Connection updated."
    }
  },
